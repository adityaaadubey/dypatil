# ==============================================================================
# VeyraLabs AI Intelligence Platform Environment Configuration Template
# IMPORTANT: Copy this file to .env and fill in your actual private credentials.
# NEVER commit .env to version control.
# ==============================================================================

# Server & Network Configuration
PORT=5173
SERVER_PORT=3001
NODE_ENV=development
# Comma-separated list of trusted client origins for CORS
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Relational Database Configuration
# Local SQLite default file path:
DATABASE_FILE=database/veyralabs.db
# Primary PostgreSQL production target (optional for enterprise deployments):
DATABASE_URL=postgresql://user:password@localhost:5432/veyralabs_db

# Supabase Cloud Database & Auth Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_publishable_key_here
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_publishable_key_here

# Security & Session Authentication
# Cryptographically random string (min 32 characters)
SESSION_SECRET=replace_with_random_32_character_secret_key_here
SESSION_EXPIRATION_DAYS=30
COOKIE_SECURE=false

# Token Wallet & Platform Credits Policy
INITIAL_TRIAL_CREDITS=10000
MAX_OUTPUT_TOKENS=2048
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_ATTEMPTS=15
RATE_LIMIT_INFERENCE_MAX=30

# Provider Inference API Keys (Stored strictly server-side, never exposed to client)
# Groq Official Ultra-Fast Inference API Key:
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini API key:
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_FALLBACK_API_KEY=your_gemini_fallback_key_here

# OpenRouter API key (optional for free-tier / catalogue sync):
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_FALLBACK_API_KEY=your_openrouter_fallback_key_here
# Enforce free-tier models only for OpenRouter (true/false)
FREE_MODELS_ONLY=true

# Optional Secondary Commercial Providers
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Arena Data Synchronization
VITE_ENABLE_LIVE_SYNC=true
VITE_SYNC_INTERVAL_MINUTES=60

# Production Hardening Flags
DEBUG=false
ENABLE_HELMET_HEADERS=true
