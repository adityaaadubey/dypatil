# VeyraLabs AI Intelligence Platform Environment Configuration Template
# Server & Client Ports
PORT=5173
SERVER_PORT=3001
NODE_ENV=development

# SQL Relational Database Configuration
# Local SQLite default file path:
DATABASE_FILE=database/veyralabs.db
# Primary PostgreSQL production target:
DATABASE_URL=postgresql://veyra_user:veyra_password@localhost:5432/veyralabs_db

# Security & Session Authentication
SESSION_SECRET=veyralabs_super_secret_session_key_32_characters_minimum
SESSION_EXPIRATION_DAYS=30

# Token Wallet & Platform Credits Policy
INITIAL_TRIAL_CREDITS=10000
MAX_OUTPUT_TOKENS=2048
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_ATTEMPTS=15

# Provider Inference API Keys (Stored strictly on backend server)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Arena Data Synchronization
VITE_ENABLE_LIVE_SYNC=true
VITE_SYNC_INTERVAL_MINUTES=60
